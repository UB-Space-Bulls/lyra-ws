<!-- ZED2 Camera Links -->
<link name="zed2_camera_link">
  <visual>
    <origin xyz="0 0 0" rpy="0 0 1.5708"/>
    <geometry>
      <box size="0.175 0.03 0.03"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <inertial>
    <mass value="0.16"/>
    <inertia ixx="0.001" ixy="0" ixz="0"
             iyy="0.001" iyz="0" izz="0.001"/>
  </inertial>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <box size="0.175 0.03 0.03"/>
    </geometry>
  </collision>
</link>

<link name="zed2_imu_link">
  <inertial>
    <mass value="0.001"/>
    <inertia ixx="0.00001" ixy="0" ixz="0"
             iyy="0.00001" iyz="0" izz="0.00001"/>
  </inertial>
</link>

<joint name="zed2_imu_joint" type="fixed">
  <parent link="zed2_camera_link"/>
  <child link="zed2_imu_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>


<joint name="zed2_camera_joint" type="fixed">
  <parent link="base_link"/>
  <child link="zed2_camera_link"/>
  <!-- Adjust xyz to where your camera sits on the rover -->
  <origin xyz="0.15 0 0.2" rpy="0 0 0"/>
</joint>

<!-- ==================== JOINTS ==================== -->

<joint name="Wheel_f1" type="continuous">
  <origin xyz="-0.332727 -0.109787 -0.083488" rpy="0 0 0"/>
  <parent link="Suspension_f1_1"/>
  <child link="Wheel_f1_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="Wheel_b1" type="continuous">
  <origin xyz="0.334113 -0.109787 -0.077759" rpy="0 0 0"/>
  <parent link="Suspension_b1_1"/>
  <child link="Wheel_b1_1"/>
  <axis xyz="0.0 1.0 -0.0"/>
</joint>

<joint name="Wheel_f2" type="continuous">
  <origin xyz="-0.3326 0.109787 -0.0834" rpy="0 0 0"/>
  <parent link="Suspension_f2_1"/>
  <child link="Wheel_f2_1"/>
  <axis xyz="-0.0 1.0 -0.0"/>
</joint>

<joint name="Wheel_b2" type="continuous">
  <origin xyz="0.331827 0.109787 -0.086997" rpy="0 0 0"/>
  <parent link="Suspension_b2_1"/>
  <child link="Wheel_b2_1"/>
  <axis xyz="-0.0 1.0 0.0"/>
</joint>

<joint name="Center_DeadAxle_f1" type="fixed">
  <origin xyz="0.0 -0.2032 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Suspension_f1_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<joint name="Center_DeadAxle_f2" type="fixed">
  <origin xyz="0.0 0.2032 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Suspension_f2_1"/>
  <axis xyz="-0.0 1.0 -0.0"/>
</joint>

<joint name="Center_DeadAxle_b2" type="fixed">
  <origin xyz="0.0 0.2032 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Suspension_b2_1"/>
  <axis xyz="-0.0 1.0 -0.0"/>
</joint>

<joint name="Center_DeadAxle_b1" type="fixed">
  <origin xyz="0.0 -0.2032 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Suspension_b1_1"/>
  <axis xyz="0.0 -1.0 0.0"/>
</joint>

<!--
  Linear actuator joints:
  - LinAct_Body_* joints REMOVED for b1, f1, f2 — they gave those Base links two parents
  - LinAct_Body_b2 KEPT — it is the only parent for 4InchBase_b2_1
  - Chain is: Suspension -> Rod (Stroke) -> Base (Slider)
-->

<joint name="LinAct_Stroke_b1" type="fixed">
  <origin xyz="0.094063 -0.020074 -0.016277" rpy="0 0 0"/>
  <parent link="Suspension_b1_1"/>
  <child link="4InchRod_b1_1"/>
  <axis xyz="0.0 1.0 -0.0"/>
</joint>

<joint name="LinAct_Slider_b1" type="fixed">
  <origin xyz="0.214674 -0.066588 0.064278" rpy="0 0 0"/>
  <parent link="4InchRod_b1_1"/>
  <child link="4InchBase_b1_1"/>
  <axis xyz="-0.204096 -0.0 0.978951"/>
  <limit upper="0.0" lower="0.0" effort="100" velocity="100"/>
</joint>

<joint name="LinAct_Stroke_f1" type="fixed">
  <origin xyz="-0.09377 -0.026424 -0.017891" rpy="0 0 0"/>
  <parent link="Suspension_f1_1"/>
  <child link="4InchRod_f1_1"/>
  <axis xyz="-0.0 -1.0 0.0"/>
</joint>

<joint name="LinAct_Slider_f1" type="fixed">
  <origin xyz="0.229081 0.066675 -0.025992" rpy="0 0 0"/>
  <parent link="4InchRod_f1_1"/>
  <child link="4InchBase_f1_1"/>
  <axis xyz="-0.201267 0.0 -0.979536"/>
  <limit upper="0.0" lower="0.0" effort="100" velocity="100"/>
</joint>

<joint name="LinAct_Stroke_f2" type="fixed">
  <origin xyz="-0.083389 0.026424 -0.046467" rpy="0 1.8 0"/>
  <parent link="Suspension_f2_1"/>
  <child link="4InchRod_f2_1"/>
