<?xml version="1.0" ?>
<robot name="urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find urdf_description)/urdf/materials.xacro" />
<xacro:include filename="$(find urdf_description)/urdf/urdf.trans" />
<xacro:include filename="$(find urdf_description)/urdf/urdf.gazebo" />

<link name="base_link">
  <inertial>
    <origin xyz="0.0013343149399823772 0.00028358189866519725 0.09528357708891128" rpy="0 0 0"/>
    <mass value="12.220889046488532"/>
    <inertia ixx="0.388779" iyy="0.234761" izz="0.562331" ixy="0.000927" iyz="-0.0001" ixz="-0.000707"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find urdf_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find urdf_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

