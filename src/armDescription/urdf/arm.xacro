<joint name="world_fixed" type="fixed">
  <parent link="world"/>
  <child link="base_link"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<joint name="Revolute 6" type="continuous">
  <origin xyz="0.0 0.21775 0.0" rpy="0 0 0"/>
  <parent link="first_joint_v1_1"/>
  <child link="Component11_v2_v1_2"/>
  <axis xyz="-0.0 -1.0 -0.0"/>
</joint>

<joint name="Slider 7" type="prismatic">
  <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="Component11_v2_v1_1"/>
  <axis xyz="0.0 1.0 0.0"/>
  <limit upper="0.81" lower="0.0" effort="100" velocity="100"/>
</joint>

